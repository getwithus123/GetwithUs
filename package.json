{
  "name": "getwithus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm guard && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "guard": "node scripts/guard.mjs",
    "guard:strict": "cross-env GUARD_STRICT=1 node scripts/guard.mjs",
    "icons": "node scripts/icons.mjs",
    "knip": "cross-env KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "check": "pnpm typecheck && pnpm lint && pnpm knip && pnpm test && pnpm guard",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "email:dev": "email dev --dir src/server/email/templates"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@hookform/resolvers": "7.0.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@t3-oss/env-nextjs": "0.13.11",
    "@types/nodemailer": "^8.0.2",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "^10.3.1",
    "postgres": "3.4.9",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "resend": "6.37.0",
    "simple-icons": "16.36.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "three": "0.182.0",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@react-email/ui": "6.11.6",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "10.1.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "knip": "6.44.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "react-email": "6.11.6",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
