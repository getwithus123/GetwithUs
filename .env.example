# Copy to .env.local for development. Every value here is a safe example, never a real secret.
# Generate secrets with: openssl rand -base64 48

# Runtime mode. Next.js sets this; only override for scripts.
# NODE_ENV=development

# Postgres connection string. Local Docker: see docker-compose.yml. Production: Neon pooled URL.
DATABASE_URL=postgres://getwithus:getwithus@localhost:5432/getwithus

# Auth.js session encryption secret, at least 32 characters.
AUTH_SECRET=replace-with-openssl-rand-base64-48-output-000000

# Comma-separated list of team emails allowed to sign in to /admin.
ADMIN_EMAILS=owner@example.com

# Secret mixed into verification code hashes and form tokens, at least 32 characters.
VERIFICATION_PEPPER=replace-with-openssl-rand-base64-48-output-000000

# Bearer token the daily cleanup cron must send, at least 16 characters.
CRON_SECRET=replace-with-a-long-random-string

# "resend" or "smtp" sends real email. "console" prints rendered emails (and codes) to the server log only.
EMAIL_TRANSPORT=console

# Resend API key. Required when EMAIL_TRANSPORT=resend.
RESEND_API_KEY=

# SMTP server. SMTP_HOST is required when EMAIL_TRANSPORT=smtp.
# SMTP_SECURE=true uses TLS from the start (port 465; also the default when
# SMTP_SECURE is unset and SMTP_PORT=465). Otherwise the connection must upgrade
# with STARTTLS (usually port 587) or nothing is sent.
# SMTP_PORT defaults to 465 when SMTP_SECURE=true and 587 otherwise.
# SMTP_PASS is required when SMTP_USER is set.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# Sender for every email, on a domain verified with the email provider.
EMAIL_FROM="GetwithUs <no-reply@example.com>"

# Optional reply-to address for client-facing emails.
EMAIL_REPLY_TO=hello@example.com

# Comma-separated list of team addresses that receive new-lead emails.
TEAM_NOTIFY_EMAILS=owner@example.com

# Optional. API key the agency's own WhatsApp bot sends as x-api-key to /api/v1/integrations/leads. At least 32 characters.
LEADS_API_KEY=

# Optional. Slack incoming webhook URL. Slack notifications turn on when set.
SLACK_WEBHOOK_URL=

# Optional. WhatsApp Cloud API notifications turn on when all four are set.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# E.164 number that receives the notification, for example +15551234567.
WHATSAPP_NOTIFY_TO=
# Name of the pre-approved template; see docs/notifications.md.
WHATSAPP_TEMPLATE_NAME=

# Optional. Cloudflare Turnstile turns on when both keys are set.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public URL of the site, no trailing slash. Used for metadata, sitemap, emails, and the Origin check.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand name used in titles and emails.
NEXT_PUBLIC_SITE_NAME=GetwithUs

# Optional. Plausible domain; cookieless analytics turn on when set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional. Scheduling link; the "Book a call" button appears on /contact when set.
NEXT_PUBLIC_SCHEDULING_URL=

# Test builds only. "1" makes production-mode console emails print codes and links. Never set in production.
NEXT_PUBLIC_TEST_HOOKS=
